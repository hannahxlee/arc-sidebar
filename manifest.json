{
  "manifest_version": 3,
  "name": "hannah's hub",
  "version": "1.1.0",
  "description": "A sidebar for Chrome: favorites, bookmark-backed folders, a live GitHub PR folder, tab renaming, custom tab icons, and custom shortcuts.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open hannah's hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "bookmarks",
    "storage",
    "alarms",
    "offscreen",
    "scripting",
    "favicon",
    "clipboardWrite",
    "sessions",
    "tabGroups",
    "contextMenus",
    "search"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "copy-url": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy the current tab's URL"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle hannah's hub"
    },
    "copy-markdown-link": {
      "description": "Copy the current tab as a Markdown link"
    },
    "rename-tab": {
      "description": "Rename the current tab"
    },
    "add-to-favorites": {
      "description": "Add the current tab to Favorites"
    },
    "duplicate-tab": {
      "description": "Duplicate the current tab"
    },
    "refresh-prs": {
      "description": "Refresh GitHub pull requests"
    }
  }
}
